# Copy to .env for local use. In production set these as Vercel environment
# variables instead — never commit real values.

# vivenu API key
VIVENU_API_KEY=

# dev = staging (vivenu.dev), prod = production (vivenu.com)
VIVENU_ENV=dev

VIVENU_PROGRAM_ID=rpg_...
VIVENU_ACCESS_LIST_ID=al_...

# Field of the membership object used as the access-list external code.
# UNVERIFIED: confirm against a real member card pass before going to prod.
VIVENU_EXTERNAL_CODE_FIELD=_id

# Tags gating enrolment, mirroring the program's Customer Segment setting.
# Comma-separated = AND logic. Required — the sweep refuses to run without it.
VIVENU_REQUIRED_TAGS=PETER

# Must match the hmacKey on the vivenu webhook configuration.
VIVENU_WEBHOOK_HMAC_KEY=

# Vercel sends this as `Authorization: Bearer <value>` on cron invocations.
CRON_SECRET=
